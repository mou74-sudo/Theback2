# Copy this file to .env (or set as Vercel environment variables) before deploying.
# Do not commit the populated .env file.

# Secret used to sign and verify JWTs. Must be a long, random string.
# The app refuses to start in production if this is unset.
JWT_SECRET=replace-with-a-long-random-string

# Comma-allowed-origin for CORS. Use "*" only at TRL-3 / for local demos.
# In production set this to the deployed frontend origin, e.g. https://your-app.vercel.app
ALLOWED_ORIGIN=*

# Node environment. Vercel sets this automatically; you only need it for local prod simulation.
# NODE_ENV=production
